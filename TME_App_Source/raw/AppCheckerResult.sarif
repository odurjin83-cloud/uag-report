dRoot.dPadMonthlyExpense7","member":"Y"}}],"properties":{"level":"Medium"}},{"ruleId":"app-IndexedAccessViaCopy","ruleIndex":13,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScrDashboard.dPadRoot.dPadMonthlyExpense7.Height"}},"logicalLocations":[{"fullyQualifiedName":"ScrDashboard.dPadRoot.dPadMonthlyExpense7.Height"}],"properties":{"module":"ScrDashboard","type":"ScrDashboard.dPadRoot.dPadMonthlyExpense7","member":"Height"}}],"properties":{"level":"Medium"}},{"ruleId":"app-IndexedAccessViaCopy","ruleIndex":13,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScrDashboard.dPadRoot.dPadMonthlyMonth7.Text"}},"logicalLocations":[{"fullyQualifiedName":"ScrDashboard.dPadRoot.dPadMonthlyMonth7.Text"}],"properties":{"module":"ScrDashboard","type":"ScrDashboard.dPadRoot.dPadMonthlyMonth7","member":"Text"}}],"properties":{"level":"Medium"}},{"ruleId":"app-IndexedAccessViaCopy","ruleIndex":13,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScrReport1.Button10_2.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"ScrReport1.Button10_2.OnSelect"}],"properties":{"module":"ScrReport1","type":"ScrReport1.Button10_2","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-TextInputIsNotDelayOutput","ruleIndex":16,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ITEMS.txtSearch.DelayOutput"}},"logicalLocations":[{"fullyQualifiedName":"ITEMS.txtSearch.DelayOutput"}],"properties":{"module":"ITEMS","type":"ITEMS.txtSearch","member":"DelayOutput"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScrSync.tmrStockSync.OnTimerEnd"}},"logicalLocations":[{"fullyQualifiedName":"ScrSync.tmrStockSync.OnTimerEnd"}],"properties":{"module":"ScrSync","type":"ScrSync.tmrStockSync","member":"OnTimerEnd"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScrSync.tmrItemSync.OnTimerEnd"}},"logicalLocations":[{"fullyQualifiedName":"ScrSync.tmrItemSync.OnTimerEnd"}],"properties":{"module":"ScrSync","type":"ScrSync.tmrItemSync","member":"OnTimerEnd"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.wStock.wShortRequest.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.wStock.wShortRequest.OnSelect"}],"properties":{"module":"Screen1","type":"Screen1.wStock.wShortRequest","member":"OnSelect"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByColumn","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByService","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly on large data sets. The \"{0}\" operation is not supported by this connector."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-ReadableScreenNameNeeded","messageStrings":{"issue":{"text":"Revise screen name"}},"properties":{"howToFix":["Give the screen  a title that describes what's on the screen or what it's used for."],"whyFix":"People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. ","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Unused variable"}},"properties":{"howToFix":["Remove the unused variable."],"whyFix":"This variable is declared but is not referenced by any control, so it is not needed.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-UnusedMediaResources","messageStrings":{"issue":{"text":"Unused media files"}},"properties":{"howToFix":["Remove the unused media file in the Media pane."],"whyFix":"This media file is not referenced by any control formulas so it is not needed. Removing it will improve performance.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectDelegatableDataSource","messageStrings":{"issue":{"text":"The rows retrieved from the data source may not be complete."}},"properties":{"howToFix":["Limit the data collected from the data source by updating the formula \"ClearCollect(colPLocationMaster, 'locations (v2.0)')\" to include a filtering function, such as 'Filter' or 'Search'."],"whyFix":"Using the 'Collect' function to create a collection directly from a connected data source may not load every row if the data source is too large.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-DataSourceDefaultMaxRowsLimit","messageStrings":{"issue":{"text":"Data row limit for non-delegable queries is more than 2000"}},"properties":{"howToFix":["Update 'Data row limit for non-delegable queries' in the advanced app settings."],"whyFix":"A 'data row limit' more than 2000 may result in a slower app when running non-delegable queries, because the app will have to process every row itself, rather than running the query on the server.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Mutating a collection or data source inside ForAll may trigger excessive rule re-evaluation"}},"properties":{"howToFix":["Since ForAll returns a table, pass its result as input to the mutation function in a single batched call. For example, replace ForAll(source, Collect(c, { ... })) with Collect(c, ForAll(source, { ... })); the same pattern applies to Patch and Remove. A single batched mutation emits one change notification instead of one per iteration.","For trivial per-row updates or deletions against a data source, prefer the delegable UpdateIf or RemoveIf functions called once outside ForAll instead of iterating with ForAll."],"whyFix":"Using Collect, Patch, Remove, or another mutation function inside the body of ForAll mutates the target collection or data source once per iteration. Every control property that depends on that collection or data source re-evaluates on each mutation, which can turn a small loop into thousands of rule evaluations and, for connected data sources, a network request per row.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Collection is initialized but never updated"}},"properties":{"howToFix":["Replace the Collect or ClearCollect with a named formula on App.Formulas. For example, MyTable = Filter(source, condition). Named formulas are computed when their inputs change and do not carry the tracking cost of a collection."],"whyFix":"Collections are meant to be updated. Power Apps does extra work to keep track of every collection so that anything depending on it stays in sync when the data changes. When the data never changes after it is set, that tracking work is wasted. A named formula gives the same data without the extra cost.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-IndexedAccessViaCopy","messageStrings":{"issue":{"text":"Use Index to read a record at a given position"}},"properties":{"howToFix":["Replace Last(FirstN(t, n)) with Index(t, Min(CountRows(t), n)) — t and n stay the same as in your original expression. The Min keeps the original behavior — when n is in range it returns the n-th row, and when n is larger than the row count it returns the last row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, n).","Replace First(LastN(t, n)) with Index(t, Max(1, CountRows(t) - n + 1)) — t and n stay the same as in your original expression. The Max keeps the original behavior — when n is in range it returns the n-th-from-end row, and when n is larger than the row count it returns the first row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, CountRows(t) - n + 1)."],"whyFix":"In expressions like Last(FirstN(t, n)) and First(LastN(t, n)) — where t is the table and n is the row position — both forms materialize a copy of the table up to n rows just to return one record at the boundary. Index(t, ...) returns the record at a position directly without building the intermediate copy, avoiding the copy cost and any per-row work the copy would trigger. When n is between 1 and the row count of t (identifiers t and n should stay the same as in your original expression), the two forms return the same record; when n exceeds the row count Index errors while the FirstN/LastN forms clamp to a boundary row, so use a clamping formula such as Min(CountRows(t), n) if your data may be smaller than n.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-InefficientDelayLoading","messageStrings":{"issue":{"text":"Inefficient delay loading"}},"properties":{"howToFix":["Use variables, collections, and navigation context to share state across screens instead."],"whyFix":"Controls that reference controls on other screens can slow down app loading and navigation. Doing this may force the app to load the other screens immediately, rather than waiting until the user navigates to that screen.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Too many controls on a screen"}},"properties":{"howToFix":["Reduce the number of controls on the screen.","Break the app into more screens to reduce the per-screen complexity.","Use components to unify grouped controls that are identical across screens, reducing duplication.","Use galleries to represent a series of repeated similar controls.","Break the app into multiple apps so that each app is small and performant."],"whyFix":"Each control consumes resources, and an app may become slow or unresponsive if a screen has too many controls. The estimated complexity of \"ScrDashboard\" is 389, which exceeds the maximum threshold recommended (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-TextInputIsNotDelayOutput","messageStrings":{"issue":{"text":"Inefficient text input"}},"properties":{"howToFix":["Enable the DelayOutput property of the text input control."],"whyFix":"When a text input control has many controls that depend on its value, typing into that input can slow down the app. Setting DelayOutput to true prevents this problem by only updating dependent controls when typing stops.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}